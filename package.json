{
  "name": "fast-tree",
  "private": true,
  "version": "1.0.0",
  "description": "FastTree - a procedural SpeedTree-like tree generator built with Vue 3 + Three.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite-sandbox.mjs dev",
    "dev:raw": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "selftest": "node scripts/selftest.mjs",
    "audit": "node scripts/audit-params.mjs",
    "leaf-cards": "node scripts/prepare-leaf-cards.mjs",
    "bark-textures": "node scripts/prepare-bark-textures.mjs",
    "sandbox:dev": "node scripts/vite-sandbox.mjs dev",
    "sandbox:build": "node scripts/vite-sandbox.mjs build",
    "mcp": "node scripts/app-bridge-server.mjs",
    "mcp:check": "node scripts/mcp-selfcheck.mjs",
    "chat:check": "node scripts/chat-selfcheck.mjs",
    "review": "node scripts/code-review.mjs",
    "check": "node scripts/mcp-selfcheck.mjs && node scripts/code-review.mjs && node scripts/selftest.mjs && node scripts/audit-params.mjs && node scripts/vite-sandbox.mjs build"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.4"
  }
}
